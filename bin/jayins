#!/bin/bash
# Jayins - Instagram 图片下载器
# 自动检测平台并运行对应版本

DIR="$(cd "$(dirname "$0")" && pwd)"
OS="$(uname -s)"
ARCH="$(uname -m)"

if [ "$OS" = "Darwin" ]; then
    if [ "$ARCH" = "arm64" ]; then
        BIN="$DIR/jayins-macos-arm64"
    elif [ "$ARCH" = "x86_64" ]; then
        BIN="$DIR/jayins-macos-x86_64"
    fi
elif [ "$OS" = "Linux" ]; then
    if [ "$ARCH" = "x86_64" ]; then
        BIN="$DIR/jayins-linux-x86_64"
    elif [ "$ARCH" = "aarch64" ]; then
        BIN="$DIR/jayins-linux-aarch64"
    fi
fi

if [ -z "$BIN" ]; then
    echo "不支持的平台: $OS $ARCH"
    echo "请从源码编译: cargo build --release"
    exit 1
fi

if [ ! -f "$BIN" ]; then
    echo "未找到 $BIN"
    echo "请下载对应平台的版本或从源码编译: cargo build --release"
    exit 1
fi

exec "$BIN" "$@"
